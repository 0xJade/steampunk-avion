---
/**
 * One tiny inline-SVG icon component. No icon package, just the ~13 glyphs the
 * site actually uses, drawn on a 24×24 grid, stroked with currentColor so they
 * inherit brass/parchment from context. Keep this set small on purpose.
 */
import type { AmenityIcon } from '@config/listing';

type UtilityIcon = 'star' | 'chevron-left' | 'chevron-right' | 'external';
export type IconName = AmenityIcon | UtilityIcon;

interface Props {
  name: IconName;
  size?: number;
  class?: string;
  /** Decorative by default; pass a label to expose it to AT. */
  label?: string;
}

const { name, size = 24, class: className = '', label } = Astro.props;

// Each entry is the inner markup of a 0 0 24 24 SVG.
const paths: Record<IconName, string> = {
  // ── Amenities ──
  sleeps: '<path d="M3 18v-6a3 3 0 0 1 3-3h12a3 3 0 0 1 3 3v6M3 14h18M3 18v2M21 18v2M6 9V7a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v2"/>',
  kitchen: '<path d="M6 3v7a2 2 0 0 0 2 2h0v9M6 3v4M9 3v4M17 3c-1.5 0-2 2-2 4.5S15.5 12 17 12s2-2 2-4.5S18.5 3 17 3ZM17 12v9"/>',
  bath: '<path d="M4 12h16v2a4 4 0 0 1-4 4H8a4 4 0 0 1-4-4v-2ZM6 12V6a2 2 0 0 1 2-2c1 0 1.5.5 1.8 1M6 20l-1 1M18 20l1 1"/>',
  climate: '<path d="M3 6h18v7H3zM6 16v2M10 16v2M14 16v2M18 16v2M6.5 9.5h11"/>',
  wifi: '<path d="M5 12.5a10 10 0 0 1 14 0M8 15.5a6 6 0 0 1 8 0M12 19h.01"/>',
  tv: '<rect x="3" y="5" width="18" height="12" rx="2"/><path d="M8 21h8"/>',
  parking: '<rect x="3" y="3" width="18" height="18" rx="2"/><path d="M9 17V7h4a3 3 0 0 1 0 6H9"/>',
  patio: '<path d="M12 3v18M3 11h18M3 11a9 9 0 0 1 18 0M8 21h8"/>',
  views: '<path d="M3 20h18M3 20l5-7 3 4 4-6 6 9M3 20V8M21 20V8"/><circle cx="8" cy="6" r="1.5"/>',
  // ── Utility ──
  star: '<path d="M12 3.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8-5.2-2.7-5.2 2.7 1-5.8L3.5 9.7l5.9-.9z"/>',
  'chevron-left': '<path d="M15 6l-6 6 6 6"/>',
  'chevron-right': '<path d="M9 6l6 6-6 6"/>',
  external: '<path d="M14 4h6v6M20 4l-8 8M18 14v4a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4"/>',
};

const a11y = label
  ? { role: 'img', 'aria-label': label }
  : { 'aria-hidden': 'true', focusable: 'false' };
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill={name === 'star' ? 'currentColor' : 'none'}
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  {...a11y}
  set:html={paths[name]}
/>
