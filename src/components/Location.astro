---
import { Image } from 'astro:assets';
import { listing } from '@config/listing';

const { location } = listing;

// Detect a dropped-in static map without breaking the build when it's absent.
const mapModules = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/steampunk-express/map.{png,jpg,jpeg,webp,avif}',
  { eager: true },
);
const mapImage = Object.values(mapModules)[0]?.default;

const mapsLink = `https://www.google.com/maps/search/?api=1&query=${location.lat},${location.lng}`;
---

<section id="location" class="mx-auto max-w-5xl px-6 py-20 md:py-28">
  <p class="font-typewriter text-xs uppercase tracking-[0.2em] text-brass">Location</p>
  <h2 class="mt-3 font-display text-3xl md:text-4xl">Basecamp for red rock</h2>
  <p class="mt-4 max-w-2xl text-parchment-d">{location.blurb}</p>

  <div class="mt-10 grid gap-8 md:grid-cols-[1.3fr_1fr] md:items-center">
    <div class="overflow-hidden rounded-lg border border-brass/20">
      {
        mapImage ? (
          <a href={mapsLink} target="_blank" rel="noopener" class="block">
            <Image
              src={mapImage}
              alt={`Map showing ${listing.name} just south of downtown Moab`}
              widths={[480, 768, 1024]}
              sizes="(min-width: 768px) 60vw, 100vw"
              loading="lazy"
              class="h-full w-full object-cover"
            />
          </a>
        ) : (
          <div class="flex aspect-[4/3] items-center justify-center bg-ink-2 p-8 text-center">
            <p class="font-typewriter text-sm text-parchment-d">
              Static map goes here —<br />drop <code>map.png</code> in
              <code>src/assets/steampunk-express/</code>.
            </p>
          </div>
        )
      }
    </div>

    <div>
      <h3 class="font-display text-xl text-parchment">Drive times</h3>
      <ul class="mt-4 divide-y divide-brass/15">
        {
          location.driveTimes.map((d) => (
            <li class="flex items-baseline justify-between gap-4 py-3">
              <span class="text-parchment">{d.place}</span>
              <span class="whitespace-nowrap font-typewriter text-sm text-brass-lit">
                {d.minutes} min
              </span>
            </li>
          ))
        }
      </ul>
      <a
        href={mapsLink}
        target="_blank"
        rel="noopener"
        class="mt-6 inline-block font-body text-brass-lit underline-offset-4 transition-colors duration-250 ease-soft hover:text-filament hover:underline"
      >
        Open in Maps →
      </a>
    </div>
  </div>
</section>
