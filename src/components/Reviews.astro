---
import { listing as defaultListing, type ListingConfig } from '@config/listing';
import Icon from './icons/Icon.astro';

interface Props {
  listing?: ListingConfig;
}
const { listing = defaultListing } = Astro.props;
const { reviews, airbnbUrl, badges } = listing;
const allReviewsUrl = `${airbnbUrl}/reviews`;
---

<section id="reviews" class="bg-plum/40 py-20 md:py-28">
  <div class="mx-auto max-w-5xl px-6">
    <div class="flex flex-col items-center text-center">
      <p class="font-typewriter text-xs uppercase tracking-[0.2em] text-[var(--accent)]">
        Reviews
      </p>
      <div class="mt-4 flex items-center gap-3">
        <span class="flex text-brass-lit" aria-hidden="true">
          {Array.from({ length: 5 }).map(() => <Icon name="star" size={20} />)}
        </span>
        <span class="font-display text-2xl text-parchment">{reviews.rating.toFixed(2)}</span>
      </div>
      <p class="mt-2 text-parchment-d">
        {reviews.count} reviews{badges.guestFavorite ? ' · Guest Favorite' : ''}
      </p>
    </div>

    <ul class="mt-14 grid gap-6 md:grid-cols-3">
      {
        reviews.quotes.map((q) => (
          <li class="card-bulb rounded-lg p-6">
            <blockquote class="text-parchment">
              <p class="text-[0.98rem] leading-relaxed">“{q.quote}”</p>
              <footer class="mt-4 font-typewriter text-xs text-parchment-d">
                — {q.author}
                {q.context && <span class="text-parchment-d"> · {q.context}</span>}
              </footer>
            </blockquote>
          </li>
        ))
      }
    </ul>

    <div class="mt-12 text-center">
      <a
        href={allReviewsUrl}
        target="_blank"
        rel="noopener"
        class="inline-flex items-center gap-2 font-body text-brass-lit underline-offset-4 transition-colors duration-250 ease-soft hover:text-filament hover:underline"
      >
        Read all {reviews.count} reviews on Airbnb
        <Icon name="external" size={16} />
      </a>
    </div>
  </div>
</section>
