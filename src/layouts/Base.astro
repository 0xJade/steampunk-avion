---
import '../styles/global.css';
import Header from '@components/Header.astro';
import { listing as defaultListing, type ListingConfig } from '@config/listing';

interface Props {
  title?: string;
  description?: string;
  /** The property this page represents (drives JSON-LD/OG). Omit for the home page. */
  listing?: ListingConfig;
  /** Path for the canonical URL, e.g. "/diner-and-movie". */
  canonicalPath?: string;
  /** "lodging" emits LodgingBusiness JSON-LD; "none" skips it (home overview). */
  schema?: 'lodging' | 'none';
}

const {
  title = `${defaultListing.name} · Moab, Utah`,
  description = defaultListing.tagline,
  listing = defaultListing,
  canonicalPath = '/',
  schema = 'lodging',
} = Astro.props;

const canonical = new URL(canonicalPath, listing.seo.siteUrl).href;
const ogImage = listing.seo.ogImage;

// Schema.org: LodgingBusiness + AggregateRating, per property. Omitted on the
// home overview (schema="none").
const jsonLd =
  schema === 'lodging'
    ? {
        '@context': 'https://schema.org',
        '@type': 'LodgingBusiness',
        name: listing.name,
        description: listing.tagline,
        url: canonical,
        image: ogImage,
        petsAllowed: false,
        numberOfRooms: listing.capacity.bedrooms,
        address: {
          '@type': 'PostalAddress',
          addressLocality: 'Moab',
          addressRegion: 'UT',
          addressCountry: 'US',
        },
        geo: {
          '@type': 'GeoCoordinates',
          latitude: listing.location.lat,
          longitude: listing.location.lng,
        },
        aggregateRating: {
          '@type': 'AggregateRating',
          ratingValue: listing.reviews.rating,
          reviewCount: listing.reviews.count,
          bestRating: 5,
          worstRating: 1,
        },
        amenityFeature: listing.amenities.map((a) => ({
          '@type': 'LocationFeatureSpecification',
          name: a.label,
          value: true,
        })),
      }
    : null;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="canonical" href={canonical} />
    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Preload the most impactful fonts (display H1 + body). Others swap in. -->
    <link
      rel="preload"
      href="/fonts/cinzel-latin-600.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/inter-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={listing.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={`${listing.name}, restored Avion trailer interior`} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <meta name="theme-color" content="#14100D" />

    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body class="grain">
    <Header />
    <slot />
  </body>
</html>
