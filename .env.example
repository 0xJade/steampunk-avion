# ─────────────────────────────────────────────────────────────────────────────
# Availability provider configuration
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# ─────────────────────────────────────────────────────────────────────────────

# Which provider the site uses. One of: ical | mock | pms
# Default is `ical` (Airbnb .ics export, no pricing). Use `mock` for local dev
# before you have the real .ics URL.
AVAILABILITY_PROVIDER=ical

# Airbnb calendar export URL (.ics). Host dashboard →
# Calendar → Availability → Export Calendar. Treat as a secret.
# Required when AVAILABILITY_PROVIDER=ical.
ICS_URL=

# How long (seconds) the serverless endpoint caches the parsed calendar.
# Brief allows 15–30 min; default 1200 (20 min).
AVAILABILITY_CACHE_SECONDS=1200

# ── Future PMS / channel-manager provider (stub) ────────────────────────────
# Only needed when AVAILABILITY_PROVIDER=pms. Not functional yet.
PMS_API_KEY=
PMS_BASE_URL=
